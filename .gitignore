# C/C++ and CMake build directories
build/
build-*/
cmake-build-*/
out/
bin/
lib/
lib64/
obj/
objs/

# CMake and build system generated files
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
compile_commands.json
CTestTestfile.cmake
DartConfiguration.tcl
Testing/
Makefile
install_manifest.txt
build.ninja
.ninja_deps
.ninja_log

# Generated binaries and libraries
*.o
*.obj
*.lo
*.la
*.a
*.so
*.so.*
*.dylib
*.dll
*.lib
*.exe
*.out
*.app
# Preprocessor output only. Do not broaden this to "*.i*" — that also swallows
# every "*.in" template (the version header, the AppStream metainfo), which
# then silently never reaches a CI checkout.
*.i
*.ii

# Debug and profiler output
*.dSYM/
*.pdb
*.idb
*.stackdump
*.gcda
*.gcno
*.gcov
*.prof
*.profraw
*.profdata
*.dmp

# Test artifacts and reports
*.xml
*.tap
*.trs
*.log
*.tmp
*.cache
coverage/
coverage-*/
htmlcov/
*.lcov
*.info

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class

# Python packaging/build artifacts
.Python
python-build/
dist/
site/
*.egg
*.egg-info/
.eggs/
pip-wheel-metadata/

# Python virtual environments and tooling
.venv/
venv/
env/
ENV/
.tox/
.nox/
.pytest_cache/
.mypy_cache/
.pyre/
.pytype/
.ruff_cache/
.hypothesis/
.ipynb_checkpoints/

# Python lock and local env files
.python-version
.env
.env.*
*.env

# AI artifacts
memory/

# Common editor/OS artifacts
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Nix and local results
result
result-*

# Flatpak build tree, module cache, exported repo and bundles
.flatpak-builder/
flatpak-build/
flatpak-repo/
*.flatpak

# Ignore any CVBS video output files and associated metadata
*.cvbs
*.cvbsy
*.cvbsc
*.meta

# Local scratch output directory
/output/

# Media a manual project run drops beside its YAML. Batch runs redirect the
# {output} root into the build tree (scripts/run-projects.sh) and land nowhere
# near here, but a bare "videosynth --project projects/..." writes in place.
/projects/**/*.wav
/projects/**/*.efm

# Media from manual project runs whose {output} root is left at its default
/tests/general-output/
/tests/general-yc-output/
/docs/examples/output/
